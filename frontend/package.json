{
  "name": "svelte-idas-app",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:open": "concurrently \"npm:dev:backend\" \"npm:dev:frontend -- --open\"",
    "dev:backend": "cd ../backend && dotnet watch",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && cd ../backend && dotnet build",
    "build:frontend": "vite build && vite build --config vite.neherapp3.config.js",
    "preview": "cd ../backend && dotnet run",
    "svelte-check": "svelte-check",
    "svelte-check:watch": "svelte-check --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:prod": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@gandalan/weblibs": "^2.0.24",
    "@lucide/svelte": "^1.59.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
